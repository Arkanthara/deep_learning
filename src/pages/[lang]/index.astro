---
import Layout from '../../layouts/Layout.astro';
import Network from '../../components/Network.astro';
import {chapters,lessons,languages,href,type Lang} from '../../data/course';
export function getStaticPaths(){return languages.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Lang;
const t=(fr:string,en:string)=>lang==='fr'?fr:en;
---
<Layout lang={lang} title={t('Parcours','Learning path')}>
  <section class="hero">
    <div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> {t('TA PROCHAINE COMPÉTENCE COMMENCE ICI','YOUR NEXT SKILL STARTS HERE')}</p><h1>{t('Le deep learning,','Deep learning,')}<br/><span>{t('une notion à la fois.','one concept at a time.')}</span></h1><p class="hero-description">{t('Des premiers tenseurs aux Transformers. Comprends les idées, révise l’essentiel et mets tes connaissances à l’épreuve.','From your first tensors to Transformers. Understand the ideas, revisit the essentials and put your knowledge to the test.')}</p><div class="hero-actions"><a class="button primary" data-resume href={href(`${lang}/lessons/1-1/`)}><span data-resume-label>{t('Commencer le parcours','Start learning')}</span> <span aria-hidden="true">↗</span></a><a class="text-link" href={href(`${lang}/review/`)}>{t('Réviser l’essentiel','Review the essentials')} <span aria-hidden="true">→</span></a></div><p class="source-note">{t('D’après le cours de François Fleuret · FR / EN','Based on François Fleuret’s course · FR / EN')}</p></div>
    <div class="hero-art"><div class="terminal-heading"><span><i></i><i></i><i></i></span><span>neural_network.py</span><span>↗</span></div><Network/><div class="terminal-caption"><code><span>learning</span> = understanding + practice</code><span class="live-pill">{t('À TON RYTHME','AT YOUR PACE')}</span></div></div>
  </section>
  <section class="stats-strip" aria-label={t('Aperçu du parcours','Course overview')}><div><strong>13</strong><span>{t('chapitres à explorer','chapters to explore')}</span></div><div><strong>{lessons.length}</strong><span>{t('leçons expliquées','explained lessons')}</span></div><div><strong>{lessons.length}</strong><span>{t('questions pour pratiquer','practice questions')}</span></div><div><strong><span data-completed-count>0</span><small> / {lessons.length}</small></strong><span>{t('leçons terminées','lessons completed')}</span></div></section>
  <div class="path-heading"><div><p class="eyebrow">{t('LA CARTE DU PARCOURS','YOUR LEARNING MAP')}</p><h2>{t('Choisis ton prochain chapitre','Choose your next chapter')}</h2></div><label class="search-box"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg><span class="sr-only">{t('Rechercher une notion','Search for a concept')}</span><input id="course-search" type="search" placeholder={t('Rechercher une notion…','Search for a concept…')} autocomplete="off"/></label></div>
  <p class="search-status muted" aria-live="polite" id="search-status" hidden></p>
  <div class="chapter-grid" id="chapter-grid">
    {chapters.map(c=><a class="chapter-card" href={href(`${lang}/chapters/${c.id}/`)} data-chapter={c.id} data-lesson-ids={c.lessons.map(l=>l.id).join(',')}><div class="card-top"><span class="chapter-badge">{String(c.id).padStart(2,'0')}</span><span class="card-group">{c.group[lang]}</span><span class="card-arrow" aria-hidden="true">↗</span></div><h3>{c.title[lang]}</h3><p>{c.description[lang]}</p><div class="card-meta"><span>{c.lessons.length} {t('leçons','lessons')}</span><span>·</span><span>{t('Fiche + quiz','Notes + quiz')}</span><span class="card-progress" data-card-progress>0/{c.lessons.length}</span></div><div class="progress-track"><span data-card-bar></span></div></a>)}
  </div>
  <div id="search-results" class="lesson-list" hidden>{lessons.map(l=><a href={href(`${lang}/lessons/${l.id}/`)} data-search={([l.id,l.title.fr,l.title.en,l.intro[lang],...l.summary[lang]]).join(' ')}><span class="lesson-number">{l.id.replace('-','.')}</span><div><strong>{l.title[lang]}</strong><small>{t('Chapitre','Chapter')} {l.chapter} · {chapters[l.chapter-1].title[lang]}</small></div><span aria-hidden="true">→</span></a>)}</div>
  <section class="bottom-grid"><a class="revision-banner" href={href(`${lang}/review/`)}><span class="banner-icon" aria-hidden="true">▤</span><div><p class="eyebrow">{t('AVANT L’EXAMEN','BEFORE THE EXAM')}</p><h3>{t('Moins de temps ? Garde l’essentiel.','Short on time? Keep the essentials.')}</h3><p>{t('Formules, idées clés et pièges fréquents dans tes fiches de révision.','Formulas, key ideas and common pitfalls in your revision notes.')}</p></div><span aria-hidden="true">↗</span></a><a class="draft-card" href={href(`${lang}/draft/`)}><span class="tag">{t('BROUILLON DU COURS','COURSE DRAFT')}</span><h3>14 / Compute Schism</h3><p>{t('Un aperçu des thèmes du dernier handout.','A glimpse of the final handout’s themes.')} →</p></a></section>
</Layout>
