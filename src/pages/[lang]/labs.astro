---
import Layout from '../../layouts/Layout.astro';import {languages,type Lang} from '../../data/course';
export function getStaticPaths(){return languages.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Lang;const t=(fr:string,en:string)=>lang==='fr'?fr:en;
---
<Layout lang={lang} title={t('Laboratoire','Lab')} route="labs/" active="labs"><div class="reading-width"><header class="page-heading"><p class="eyebrow">{t('LE LABORATOIRE / ÉTAPE 2','THE LAB / PHASE 2')}</p><h1>{t('Bientôt, place aux expériences.','Next up: hands-on experiments.')}</h1><p>{t('Cette première version se concentre sur le cours, les fiches et les quiz. Les expériences ci-dessous sont prévues pour la suite ; elles ne sont pas encore disponibles.','This first version focuses on lessons, revision notes and quizzes. The experiments below are planned for the next phase; they are not available yet.')}</p></header><div class="roadmap">{[[t('Régression en direct','Live regression'),t('Ajuster la pente et le biais, observer la droite et l’erreur quadratique.','Adjust slope and bias, then observe the line and mean squared error.')],[t('Descente de gradient','Gradient descent'),t('Modifier le taux d’apprentissage et comparer les trajectoires sur une fonction de perte.','Change the learning rate and compare trajectories on a loss function.')],[t('Python dans le navigateur','Python in the browser'),t('Exécuter de petits exemples NumPy avec Pyodide dans un Web Worker. Les exemples PyTorch nécessiteront un environnement séparé.','Run small NumPy examples with Pyodide in a Web Worker. PyTorch examples will require a separate environment.')]].map(([title,description],i)=><section class="panel"><span class="chapter-badge">0{i+1}</span><div><h2>{title}</h2><p>{description}</p><span class="tag">{t('PRÉVU POUR LA V2','PLANNED FOR V2')}</span></div></section>)}</div></div></Layout>
