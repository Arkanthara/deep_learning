---
import Layout from '../../layouts/Layout.astro';import {chapters,languages,href,type Lang} from '../../data/course';
export function getStaticPaths(){return languages.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Lang;const t=(fr:string,en:string)=>lang==='fr'?fr:en;
---
<Layout lang={lang} title={t('Sources et crédits','Sources and credits')} route="sources/"><div class="reading-width"><header class="page-heading"><p class="eyebrow">{t('LE COURS, SES SOURCES','THE COURSE AND ITS SOURCES')}</p><h1>{t('Comprendre d’où viennent les idées.','Know where the ideas come from.')}</h1></header><div class="prose"><p>{t('Ce site est une adaptation pédagogique indépendante du cours « Deep Learning » de François Fleuret, à partir des 63 PDF fournis dans le dossier handout. Il ne s’agit pas du site officiel du cours et cette adaptation n’implique aucune approbation de l’auteur.','This site is an independent educational adaptation of François Fleuret’s “Deep Learning” course, based on the 63 PDFs supplied in the handout directory. It is not the official course website and this adaptation does not imply endorsement by the author.')}</p><p><a href="https://fleuret.org/dlc/">{t('Cours original de François Fleuret','François Fleuret’s original course')} ↗</a></p><h2>{t('Une adaptation, avec accès au support complet','An adaptation with access to the complete source')}</h2><p>{t('Les leçons reformulent les notions principales, les exemples et les rappels en français et en anglais. Elles ajoutent des questions corrigées et des exemples pédagogiques ; elles ne reproduisent pas toutes les démonstrations, figures ou références des 1 198 pages. Les liens sous chaque leçon indiquent les pages du PDF, comptées depuis la couverture, qui étayent les explications. Les exemples historiques restent situés dans le contexte du support.','Lessons restate the main concepts, examples and revision points in French and English. They add explained questions and educational examples; they do not reproduce every derivation, figure or reference from the 1,198 pages. Links below each lesson identify supporting PDF pages counted from the cover. Historical examples remain in the source’s context.')}</p><h2>{t('Attribution et licence','Attribution and licence')}</h2><p>{t('Auteur des handouts : François Fleuret. Les supports et le contenu pédagogique adapté sont proposés sous Creative Commons Attribution – Pas d’Utilisation Commerciale – Partage dans les Mêmes Conditions 4.0 International (CC BY-NC-SA 4.0). Les éventuels éléments tiers conservent les crédits et conditions indiqués dans les PDF.','Handout author: François Fleuret. The sources and adapted educational content are provided under Creative Commons Attribution–NonCommercial–ShareAlike 4.0 International (CC BY-NC-SA 4.0). Third-party material retains the credits and terms specified in the PDFs.')}</p><p><a href={href('handout/by-nc-sa-4.0.txt')}>{t('Lire la licence fournie','Read the supplied licence')}</a></p><h2>{t('Les chapitres sources','Source chapters')}</h2><table class="credits-table"><thead><tr><th>{t('Chapitre','Chapter')}</th><th>{t('Parties','Parts')}</th><th>{t('Accès','Access')}</th></tr></thead><tbody>{chapters.map(c=><tr><td>{c.id} · {c.title[lang]}</td><td>{c.lessons.length}</td><td><a href={href(`${lang}/chapters/${c.id}/`)}>{t('Ouvrir','Open')} →</a></td></tr>)}</tbody></table><p style="margin-top:20px"><a href={href(`${lang}/draft/`)}>14 · Compute Schism ({t('brouillon','draft')}) →</a></p><h2>{t('Ta progression','Your progress')}</h2><p>{t('Les leçons terminées, la dernière leçon ouverte et les meilleurs scores sont enregistrés uniquement dans le stockage local de ce navigateur. Il n’y a pas de compte, de synchronisation entre appareils ou d’outil de suivi publicitaire. Changer de langue conserve la progression. Effacer les données du navigateur la supprime.','Completed lessons, the last opened lesson and best scores are stored only in this browser’s local storage. There is no account, cross-device synchronisation or advertising tracker. Switching language preserves progress. Clearing browser data removes it.')}</p><div class="reset-area"><button class="button" data-reset-progress>{t('Effacer ma progression locale','Clear my local progress')}</button></div></div></div></Layout>
